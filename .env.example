# ─── Application ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
DATA_DIR=/data

# Set to 'true' when running behind a reverse proxy (Caddy, nginx, Traefik)
TRUST_PROXY=true

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# Single shared password for all users
ADMIN_PASSWORD=change-me

# Set to 'true' to enforce HTTPS-only session cookies (recommended in production)
SESSION_SECURE=true

# ─── Transcription (Whisper-compatible API) ────────────────────────────────────
# Local Whisper server (e.g. speaches, whisper.cpp, faster-whisper-server)
TRANSCRIPTION_URL=http://localhost:8000/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=Systran/faster-whisper-small

# ─── LLM (Ollama / OpenAI-compatible API) ─────────────────────────────────────
# Ollama (local):  http://localhost:11434/v1   (API key not required)
# OpenAI:          https://api.openai.com/v1
LLM_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3

# ─── Invoice Ninja (optional) ──────────────────────────────────────────────────
INVOICENINJA_URL=
INVOICENINJA_API_KEY=

# ─── Google Calendar OAuth (optional) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
